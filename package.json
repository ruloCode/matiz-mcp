{
  "name": "matiz-mcp",
  "version": "0.3.0",
  "description": "Matiz: MCP de referencias de diseño: pantallas, secciones, marca y composición como DATOS (tokens, estructura, DESIGN.md), capturadas de la web pública.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "matiz-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "data/corpus-pack.json.gz",
    "data/seed-sites.json",
    "data/free-fonts.json",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "design",
    "design-tokens",
    "design-md",
    "ui",
    "references",
    "claude",
    "codex",
    "cursor",
    "design-system",
    "brand",
    "tailwind",
    "playwright",
    "mobbin-alternative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruloCode/matiz-mcp.git"
  },
  "homepage": "https://matiz-mcp.vercel.app",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');for(const n of ['extract','tree','brand','deep'])f.copyFileSync('src/capture/'+n+'.browser.js','dist/capture/'+n+'.browser.js');f.copyFileSync('src/gallery/app.html','dist/gallery/app.html');f.copyFileSync('src/gallery/studio.html','dist/gallery/studio.html');for(const n of ['probe','tells'])f.copyFileSync('src/studio/'+n+'.browser.js','dist/studio/'+n+'.browser.js');f.copyFileSync('src/studio/app-view.html','dist/studio/app-view.html')\"",
    "prepare": "npm run build",
    "export-pack": "tsx scripts/export-pack.ts",
    "build:fonts": "tsx scripts/build-fonts.ts",
    "eval": "tsx scripts/eval.ts",
    "ask": "tsx scripts/ask.ts",
    "build:site": "tsx scripts/build-site.ts",
    "build:og": "tsx scripts/build-og.ts",
    "build:explore": "tsx scripts/build-explore.ts",
    "recapture": "tsx scripts/recapture.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "capture": "tsx scripts/capture.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:design-md": "tsx scripts/seed-design-md.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:studio": "tsx scripts/studio-smoke.ts",
    "gallery": "tsx src/cli.ts gallery",
    "reanalyze": "tsx scripts/reanalyze.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/cli.ts",
    "deep": "tsx scripts/deep.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tailwindcss/browser": "4.1.18",
    "playwright": "1.64.0",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "mcpName": "io.github.ruloCode/matiz-mcp",
  "author": "Rulo (https://github.com/ruloCode)"
}
