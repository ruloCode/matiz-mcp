{
  "name": "matiz-mcp",
  "version": "0.1.0",
  "description": "Matiz: MCP de referencias de diseño: pantallas, secciones, marca y composición como DATOS (tokens, estructura, DESIGN.md), capturadas de la web pública.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "matiz-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "data/corpus-pack.json.gz",
    "data/seed-sites.json",
    "data/free-fonts.json"
  ],
  "keywords": ["mcp", "mcp-server", "design", "design-tokens", "design-md", "ui", "references", "claude", "codex", "cursor"],
  "repository": { "type": "git", "url": "git+https://github.com/ruloCode/matiz-mcp.git" },
  "homepage": "https://github.com/ruloCode/matiz-mcp#readme",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/capture/extract.browser.js','dist/capture/extract.browser.js')\"",
    "prepare": "npm run build",
    "export-pack": "tsx scripts/export-pack.ts",
    "build:fonts": "tsx scripts/build-fonts.ts",
    "eval": "tsx scripts/eval.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "capture": "tsx scripts/capture.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:design-md": "tsx scripts/seed-design-md.ts",
    "smoke": "tsx scripts/smoke.ts",
    "reanalyze": "tsx scripts/reanalyze.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.64.0",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
