{
  "name": "matiz-mcp",
  "version": "0.1.0",
  "description": "Matiz: MCP de referencias de diseño: pantallas, secciones, marca y composición como DATOS (tokens, estructura, DESIGN.md), capturadas de la web pública.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "matiz-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp src/capture/extract.browser.js dist/capture/",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "capture": "tsx scripts/capture.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:design-md": "tsx scripts/seed-design-md.ts",
    "smoke": "tsx scripts/smoke.ts",
    "reanalyze": "tsx scripts/reanalyze.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.64.0",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
